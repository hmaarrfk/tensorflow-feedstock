From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Sun, 22 Mar 2026 00:00:00 +0000
Subject: [PATCH 37/37] Use root grpc plugin targets for system com_github_grpc_grpc

third_party/systemlibs/grpc.BUILD already exposes grpc_cpp_plugin and
grpc_python_plugin as sh_binary wrappers. Vendored bazel/*.bzl still pointed at
//src/compiler:* which is absent when the tarball is not extracted. Point them
at //:* and alias the Objective-C plugin to the C++ plugin for Linux builds.
---
 third_party/systemlibs/grpc.BUILD                         | 6 ++++++
 third_party/systemlibs/grpc_conda_bazel/cc_grpc_library.bzl | 2 +-
 third_party/systemlibs/grpc_conda_bazel/generate_objc.bzl   | 2 +-
 third_party/systemlibs/grpc_conda_bazel/python_rules.bzl    | 2 +-
 4 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/third_party/systemlibs/grpc.BUILD b/third_party/systemlibs/grpc.BUILD
index 11111111..22222222 100644
--- a/third_party/systemlibs/grpc.BUILD
+++ b/third_party/systemlibs/grpc.BUILD
@@ -72,3 +72,9 @@ sh_binary(
     srcs = ["grpc_python_plugin.bin"],
     visibility = ["//visibility:public"],
 )
+
+alias(
+    name = "grpc_objective_c_plugin",
+    actual = ":grpc_cpp_plugin",
+    visibility = ["//visibility:public"],
+)
diff --git a/third_party/systemlibs/grpc_conda_bazel/cc_grpc_library.bzl b/third_party/systemlibs/grpc_conda_bazel/cc_grpc_library.bzl
index 11111111..22222222 100644
--- a/third_party/systemlibs/grpc_conda_bazel/cc_grpc_library.bzl
+++ b/third_party/systemlibs/grpc_conda_bazel/cc_grpc_library.bzl
@@ -105,7 +105,7 @@ def cc_grpc_library(
         generate_cc(
             name = codegen_grpc_target,
             srcs = proto_targets,
-            plugin = "@com_github_grpc_grpc//src/compiler:grpc_cpp_plugin",
+            plugin = "@com_github_grpc_grpc//:grpc_cpp_plugin",
             well_known_protos = well_known_protos,
             generate_mocks = generate_mocks,
             flags = codegen_flags,
diff --git a/third_party/systemlibs/grpc_conda_bazel/generate_objc.bzl b/third_party/systemlibs/grpc_conda_bazel/generate_objc.bzl
index 11111111..22222222 100644
--- a/third_party/systemlibs/grpc_conda_bazel/generate_objc.bzl
+++ b/third_party/systemlibs/grpc_conda_bazel/generate_objc.bzl
@@ -163,7 +163,7 @@ generate_objc = rule(
             providers = [ProtoInfo],
         ),
         "plugin": attr.label(
-            default = "@com_github_grpc_grpc//src/compiler:grpc_objective_c_plugin",
+            default = "@com_github_grpc_grpc//:grpc_objective_c_plugin",
             executable = True,
             providers = ["files_to_run"],
             cfg = "exec",
diff --git a/third_party/systemlibs/grpc_conda_bazel/python_rules.bzl b/third_party/systemlibs/grpc_conda_bazel/python_rules.bzl
index 11111111..22222222 100644
--- a/third_party/systemlibs/grpc_conda_bazel/python_rules.bzl
+++ b/third_party/systemlibs/grpc_conda_bazel/python_rules.bzl
@@ -253,7 +253,7 @@ _generate_pb2_grpc_src = rule(
             executable = True,
             providers = ["files_to_run"],
             cfg = "exec",
-            default = Label("//src/compiler:grpc_python_plugin"),
+            default = Label("//:grpc_python_plugin"),
         ),
         "_protoc": attr.label(
             executable = True,
