--- /dev/null
+++ b/third_party/systemlibs/grpc_conda_bazel/python_rules.bzl
@@ -0,0 +1,310 @@
+# Copyright 2021 The gRPC Authors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
